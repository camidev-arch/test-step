{{ 'section-backed-by-science.css' | asset_url | stylesheet_tag }}

<style>
  .backed-by-science-{{ section.id }} {
    --text-color: {{ section.settings.text_color }};
    --bg-color: {{ section.settings.background_color }};
    --media-bg: {{ section.settings.media_background }};
  }
</style>

<section class="backed-by-science-{{ section.id }} backed-by-science full-width" data-section-id="{{ section.id }}">
  <div class="backed-by-science__inner">

    <div class="backed-by-science__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1200 | image_tag:
          loading: 'lazy',
          widths: '400,600,800,1000,1200',
          sizes: '(min-width: 990px) 45vw, 100vw',
          class: 'backed-by-science__image',
          alt: section.settings.image.alt
        }}
      {%- else -%}
        {% comment %} Default image bundled with the theme so the section renders before it is configured. {% endcomment %}
        <img
          class="backed-by-science__image"
          src="{{ 'image-2nd-section.png' | asset_url }}"
          alt=""
          width="630"
          height="768"
          loading="lazy"
        >
      {%- endif -%}
    </div>

    <div class="backed-by-science__content">
      {%- if section.settings.heading != blank or section.settings.heading_emphasis != blank -%}
        <h2 class="backed-by-science__heading">
          {%- if section.settings.heading != blank -%}
            <span class="backed-by-science__heading-line">{{ section.settings.heading }}</span>
          {%- endif -%}
          {%- if section.settings.heading_emphasis != blank -%}
            <span class="backed-by-science__heading-line backed-by-science__heading-line--emphasis">{{ section.settings.heading_emphasis }}</span>
          {%- endif -%}
        </h2>
      {%- endif -%}

      {%- assign group_index = 0 -%}
      {%- for block in section.blocks -%}

        {%- if block.type == 'group_label' -%}
          {%- if group_index > 0 -%}</div>{%- endif -%}
          <p class="backed-by-science__label" {{ block.shopify_attributes }}>{{ block.settings.label }}</p>
          <div class="backed-by-science__stats">
          {%- assign group_index = group_index | plus: 1 -%}
        {%- endif -%}

        {%- if block.type == 'stat' -%}
          <div class="backed-by-science__stat" {{ block.shopify_attributes }}>
            {%- if block.settings.eyebrow != blank -%}
              <p class="backed-by-science__stat-eyebrow">{{ block.settings.eyebrow }}</p>
            {%- endif -%}
            <p class="backed-by-science__stat-number">{{ block.settings.number }}</p>
            {%- if block.settings.description != blank -%}
              <p class="backed-by-science__stat-description">{{ block.settings.description }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

      {%- endfor -%}
      {%- if group_index > 0 -%}</div>{%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a
          {% if section.settings.button_link != blank %}href="{{ section.settings.button_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          class="backed-by-science__btn"
        >
          {{ section.settings.button_label }}
          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="7" y1="17" x2="17" y2="7"/><polyline points="7 7 17 7 17 17"/></svg>
        </a>
      {%- endif -%}

      {%- if section.settings.citations != blank -%}
        <div class="backed-by-science__citations">{{ section.settings.citations }}</div>
      {%- endif -%}
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Backed by science",
  "class": "section-backed-by-science",
  "settings": [
    {
      "type": "header",
      "content": "Contenido"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Portrait image works best. Falls back to the image bundled with the theme."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (line 1)",
      "default": "Backed by Science."
    },
    {
      "type": "text",
      "id": "heading_emphasis",
      "label": "Heading (line 2, emphasis)",
      "default": "Proven by Results."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "See The Science"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "richtext",
      "id": "citations",
      "label": "Citations",
      "default": "<p>&#185;Yasuda et al., 2010 &#178;Loenneke et al., 2012 &#179;Takarada et al., 2000 &#8308;Hughes et al., 2017</p>"
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Color de texto",
      "default": "#262D33"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Color de fondo",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "media_background",
      "label": "Color de fondo de la imagen",
      "default": "#F3F3F3"
    }
  ],
  "blocks": [
    {
      "type": "group_label",
      "name": "Group label",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Build lasting strength in just 3 short sessions a week"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow text",
          "default": "In a clinical study"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Stat number",
          "default": "2.0x"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "muscle strength increase vs traditional low-load training"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Backed by science",
      "blocks": [
        { "type": "group_label", "settings": { "label": "Build lasting strength in just 3 short sessions a week" } },
        { "type": "stat", "settings": { "eyebrow": "In a clinical study", "number": "2.0x", "description": "muscle strength increase vs traditional low-load training" } },
        { "type": "stat", "settings": { "eyebrow": "In a systematic review", "number": "3.2X", "description": "greater muscle mass gains compared to walking or light training without Targeted Compression/BFR" } },
        { "type": "group_label", "settings": { "label": "Clinically shown to speed up recovery" } },
        { "type": "stat", "settings": { "eyebrow": "In a recovery study", "number": "78%", "description": "faster muscle recovery time post-exercise with Targeted Compression/BFR compared to passive rest" } },
        { "type": "stat", "settings": { "eyebrow": "In a clinical trial", "number": "40-50%", "description": "pain reduction reported in individuals with chronic musculoskeletal pain" } }
      ]
    }
  ]
}
{% endschema %}
